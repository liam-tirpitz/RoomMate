{
  "name": "room-manager",
  "version": "1.0.0",
  "description": "Connects to RoomMates and provides them with room occupation information .",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "publishConfig": {
    "registry": "https://git.rwth-aachen.de/api/v4/projects/102879/packages/npm/",
    "tag": "latest"
  },
  "release": {
    "branches": [
      "production"
    ],
    "npmPublish": false,
    "tarballDir": "dist",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator"
    ]
  },
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "autostart": "./run.sh",
    "start": "node src/index.js",
    "start_bws": "bws run -- node src/index.js",
    "build": "tsc -p tsconfig.json",
    "dev_local": "tsx watch src/index.ts",
    "dev_bws": "bws run -- tsx watch src/index.ts",
    "dev_gordon": "bws run -- tsx watch src/provisioner/gordon.ts"
  },
  "keywords": [],
  "author": "Liam Tirpitz",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "@types/jsdom": "^21.1.7",
    "canvas": "^3.0.0-rc2",
    "dotenv": "^16.4.5",
    "ews-javascript-api": "^0.15.3",
    "fastify": "^5.1.0",
    "fastify-cli": "^7.0.1",
    "fastify-plugin": "^5.0.0",
    "jsdom": "^25.0.1",
    "mongodb": "^6.10.0",
    "node-ical": "^0.19.0",
    "request": "^2.88.2",
    "serialport": "^12.0.0",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.2.1",
    "@types/node": "^22.9.0",
    "nodemon": "^3.1.7",
    "semantic-release": "^24.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
